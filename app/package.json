{
  "name": "inventory-app",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:account": "vite build --config scripts/vite.scripts.config.ts && node scripts/dist/account-roundtrip.mjs",
    "check:stats": "vite build --config scripts/vite.scripts.config.ts && node scripts/dist/stats-quantity.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/share": "^8.0.1",
    "@hocuspocus/provider": "^4.4.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "nanoid": "^6.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
