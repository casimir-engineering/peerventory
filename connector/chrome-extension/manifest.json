{
  "manifest_version": 3,
  "name": "Peerventory Connector",
  "version": "0.3.0",
  "description": "Search your Peerventory inventories and autofill Anibis / Facebook Marketplace listing forms. Syncs end-to-end encrypted data; keys never leave this device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Peerventory Connector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "clipboardRead"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.anibis.ch/*", "https://anibis.ch/*"],
      "js": ["content/fill-core.js", "content/anibis.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content/fill-core.js", "content/facebook.js"],
      "run_at": "document_idle"
    }
  ]
}
