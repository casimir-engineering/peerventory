{
  "manifest_version": 3,
  "name": "Peerventory Listing Connector",
  "version": "0.1.0",
  "description": "Autofills Anibis and Facebook Marketplace listing forms from a Peerventory listing payload. Everything stays on this device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Peerventory Listing Connector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "clipboardRead"],
  "content_scripts": [
    {
      "matches": ["https://www.anibis.ch/*", "https://anibis.ch/*"],
      "js": ["content/fill-core.js", "content/anibis.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content/fill-core.js", "content/facebook.js"],
      "run_at": "document_idle"
    }
  ]
}
